#!/bin/bash

set -euo pipefail

# ============================================
# Configuration
# ============================================
OUTPUT_LANG="English"
VERBOSE=false

# ============================================
# Parse arguments
# ============================================
while [[ $# -gt 0 ]]; do
  case $1 in
  --lang)
    OUTPUT_LANG="$2"
    shift 2
    ;;
  --verbose)
    VERBOSE=true
    shift
    ;;
  --help)
    echo "Usage: $0 [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --lang LANG       Output language (default: English)"
    echo "  --verbose         Show debug information"
    echo "  --help            Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./ai-commit.sh                    # English output"
    echo "  ./ai-commit.sh --lang Indonesian  # Indonesian output"
    echo ""
    exit 0
    ;;
  *)
    echo "Unknown option: $1"
    exit 1
    ;;
  esac
done

# ============================================
# Colors for output
# ============================================
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ============================================
# Helper functions
# ============================================
log_info() {
  echo -e "${BLUE} $1${NC}"
}

log_success() {
  echo -e "${GREEN} $1${NC}"
}

log_warning() {
  echo -e "${YELLOW} $1${NC}"
}

log_error() {
  echo -e "${RED} $1${NC}"
}

debug_log() {
  if [ "$VERBOSE" = true ]; then
    echo -e "${CYAN}[DEBUG] $1${NC}"
  fi
}

# ============================================
# Verify git repository
# ============================================
if ! git rev-parse --git-dir >/dev/null 2>&1; then
  log_error "Not a git repository. Please run this script from a git project root."
  exit 1
fi

log_info "Git repository found: $(git rev-parse --show-toplevel)"

# ============================================
# Verify Qwen Code is installed
# ============================================
if ! command -v qwen &>/dev/null; then
  log_error "Qwen Code is not installed. Please install with: npm install -g @qwen-code/qwen-code@latest"
  exit 1
fi

debug_log "Qwen Code found at: $(which qwen)"
