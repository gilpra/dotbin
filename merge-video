#!/usr/bin/env bash
set -euo pipefail

OUTPUT=""
INPUTS=()

usage() {
  echo "Usage: $(basename "$0") -o <output.mp4> <input1.mp4> [input2.mp4 ...]"
  echo ""
  echo "Options:"
  echo "  -o    Output file path (required)"
  echo "  -h    Show this help message"
  exit 1
}

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
  -o)
    if [[ -z "${2:-}" ]]; then
      echo "Error: -o requires an output file argument"
      exit 1
    fi
    OUTPUT="$2"
    shift 2
    ;;
  -h | --help)
    usage
    ;;
  -*)
    echo "Error: Unknown option '$1'"
    usage
    ;;
  *)
    INPUTS+=("$1")
    shift
    ;;
  esac
done
